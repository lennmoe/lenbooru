# --- Discord OAuth ---
# 1. https://discord.com/developers/applications -> New Application
# 2. OAuth2 -> Redirects -> add: http://localhost:3000/api/auth/callback/discord
# 3. Copy Client ID / Client Secret below
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Bot Discord (liste blanche) — optionnel ---
# Meme app Discord -> onglet Bot -> Reset Token. Invite le bot sur ton serveur via
# OAuth2 -> URL Generator, scopes: bot + applications.commands (aucune permission requise).
# Commandes : /wl add, /wl remove, /wl list, et clic droit sur un membre -> Apps -> Whitelister
DISCORD_BOT_TOKEN=

# Lien d'invitation du serveur Discord, affiche sur /login et /denied (optionnel)
DISCORD_INVITE_URL=

# Random string. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Ton ID Discord — toujours "owner", meme sans etre dans la liste blanche
OWNER_DISCORD_ID=435068712786198538

# URL publique EXACTE par laquelle on accede au site (protocole + host + port).
# Doit correspondre au Redirect URI ajoute dans Discord.
# En http (pas de domaine / pas de HTTPS) Auth.js passe en cookies non-secure tout seul.
#   local :   http://localhost:3000
#   VPS   :   http://123.45.67.89:3000     (ou http://123.45.67.89 si port 80)
AUTH_URL=http://localhost:3000
